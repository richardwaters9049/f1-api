[Unit]
Description=Fast Girls Club F1 API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fgcapi
Group=fgcapi
WorkingDirectory=/home/fgcapi/f1-api
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=NODE_ENV=production
ExecStart=/home/fgcapi/.bun/bin/bun run start
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
