# F1 API environment variables
#
# Both are optional. The defaults below match the values used in development.

# Port the server prefers. If busy, the server tries the next available port.
PORT=8787

# Host the server binds to.
HOST=127.0.0.1

# Upstream Formula 1 REST provider.
F1_PROVIDER_BASE_URL=https://f1api.dev/api

# Timeout for upstream HTTP requests, in milliseconds.
UPSTREAM_TIMEOUT_MS=10000
